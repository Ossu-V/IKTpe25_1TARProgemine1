@model University.ViewModel.CourseVM.CourseDetailsViewModel

@{
    ViewData["Title"] = "Course Details";
}

<h2>Course Details</h2>
<div>
    <h4>Course</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CourseId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CourseId)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Credits)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Credits)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Department)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DepartmentId)
        </dd>
        <dt class="col-sm-2">
            Kursuse pilt
        </dt>
        <dt class="col-sm-2">
            Kursuse pilt
        </dt>
        <dd class="col-sm-10">
            @if (Model.Image != null && Model.Image.Count > 0)
            {
                dynamic firstImage = Model.Image[0];
                // Proovi esmalt ExistingFilePath, kui pilti ei tule, proovi lihtsalt FilePath
                <img src="~/images/@firstImage.FilePath" alt="Kursuse pilt" style="max-width: 300px; border-radius: 8px;" />
            }
            else
            {
                <span class="text-muted">Pilti pole üles laaditud</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Index">Back to List</a>
</div>